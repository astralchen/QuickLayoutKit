    "NSMicrophoneUsageDescription" : {
      "comment" : "Explains why the Demo requests microphone access.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم العرض التوضيحي الميكروفون لتسجيل الرسائل الصوتية وتحويل الكلام إلى نص."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The demo uses the microphone to record audio messages and convert speech to text."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "演示需要使用麦克风录制音频消息并将语音转换为文字。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "comment" : "Explains why the Demo requests speech-recognition access.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم العرض التوضيحي التعرف على الكلام لتحويل صوتك إلى مسودة رسالة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The demo uses speech recognition to turn your voice into a message draft."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "演示需要使用语音识别将你说的话转换为消息草稿。"
          }
        }
      }
    }
