    "messages.body.1" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يدخل ضوء القمر الغرفة، وتعيد الذاكرة ترتيب الحنين في بطاقة واحدة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moonlight falls into the room, and a small card keeps the memory readable."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "床前明月光，疑是地上霜。举头望明月，低头思故乡。"
          }
        }
      }
    },
    "messages.body.2" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نص طويل يختبر ارتفاع الخلية، التفاف السطور، واتجاه القراءة عند تغيير اللغة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A longer message checks self-sizing cells, wrapping, and readable layout after a language change."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "国破山河在，城春草木深。感时花溅泪，恨别鸟惊心。烽火连三月，家书抵万金。"
          }
        }
      }
    },
    "messages.body.3" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتسع الخلية لنص متعدد الأسطر وتحافظ على الهوامش بعد تبديل LTR و RTL."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This card stretches across multiple lines and keeps its margins under LTR and RTL."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "明月几时有？把酒问青天。不知天上宫阙，今夕是何年。"
          }
        }
      }
    },
    "messages.body.4" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رسالة قصيرة لاختبار توازن الخلية مع النصوص المختصرة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A short message validates compact self-sizing content."
