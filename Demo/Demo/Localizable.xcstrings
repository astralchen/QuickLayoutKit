    "fixedSize.card.0.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اترك مساحة لفكرة بسيطة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leave room for something simple."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "给简单的想法，留一点空间。"
          }
        }
      }
    },
    "fixedSize.card.0.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فكرة صغيرة"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A little idea"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一个小灵感"
          }
        }
      }
    },
    "fixedSize.card.1.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحتاج بعض الأفكار إلى أسطر إضافية. دع الكلمات تنتقل بين الأسطر بشكل طبيعي، دون اختصار القصة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some ideas need a few more lines. Let the words wrap naturally, without cutting the story short."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有些想法需要多写几行。让文字自然换行，把故事说完整，不必为了整齐而截断内容。"
          }
        }
      }
    },
    "fixedSize.card.1.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مساحة للقراءة"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Room to read"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让文字呼吸"
          }
        }
      }
    },
    "fixedSize.card.2.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تجمع الحافة المشتركة البطاقات في صف متناسق. يبقى المحتوى في الأعلى، وتحتفظ كل بطاقة بطابعها."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A shared edge brings the row together. The content stays at the top, while each card keeps its own voice."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共同的底边，让整行更有秩序。内容始终从顶部开始，每张卡片依然保留自己的表达。"
          }
        }
      }
    },
    "fixedSize.card.2.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إيقاع متناسق"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stay in rhythm"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保持节奏"
          }
        }
      }
    },
    "fixedSize.card.3.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذه أطول بطاقة، حتى عندما تبدأ خارج الشاشة. تحدد قصتها الكاملة ارتفاع الصف كله، وتتمدد البطاقات الأقصر لتطابقها. تبقى كل كلمة ظاهرة ويستخدم التخطيط المساحة التي يحتاجها فقط. جرّب تكبير حجم النص وشاهد كيف ينمو الصف مع المحتوى."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is the longest card, even when it starts outside the screen. Its full story decides the height of the entire row. The shorter cards stretch to match it, so every word remains visible and the layout uses only the space it needs. Try a larger text size and watch the row grow with the content."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使这张最长的卡片最初位于屏幕之外，它的完整内容也会决定整行的高度。较短的卡片随之伸展，让每一个字都能被看见，同时只占用真正需要的空间。试着调大系统字号，观察整行如何随着内容一起长高。"
          }
        }
      }
    },
    "fixedSize.card.3.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "القصة كاملة"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The whole story"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把故事讲完整"
          }
        }
      }
    },
    "fixedSize.compatibility" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يوفر QuickLayoutKit نسخة من fixedSize خاصة بالمكدس، تستخدم idealLayout داخلياً. طبّقها مباشرة على HStack قبل padding أو محو النوع."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QuickLayoutKit adds a stack-specific fixedSize overload. It uses idealLayout internally. Apply fixedSize directly to HStack, before padding or type erasure."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QuickLayoutKit 提供栈专用 fixedSize 重载，内部复用 idealLayout。请直接对 HStack 调用，再添加 padding；类型擦除后仍使用上游行为。"
          }
        }
      }
    },
    "fixedSize.equal" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "متساوٍ"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Equal"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "内容等高"
          }
        }
      }
    },
    "fixedSize.equal.explanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحدد أطول بطاقة ارتفاع الصف، وتتمدد البطاقات المرنة لتطابقه."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The tallest story sets the height. Every flexible card stretches to meet it."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最高的卡片决定整行高度，其余可伸展卡片随之对齐。"
          }
        }
      }
    },
    "fixedSize.fill" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ملء"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fill"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "撑满容器"
          }
        }
      }
    },
    "fixedSize.fill.explanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تملأ البطاقات حاوية بارتفاع 420 نقطة. تتساوى الارتفاعات، لكن المحتوى لا يحتاج كل هذه المساحة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every card fills a 420 pt container. Equal heights, with more space than the content needs."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
