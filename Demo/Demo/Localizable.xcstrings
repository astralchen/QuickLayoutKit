    "contentMargins.intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بدّل بين التركيبات ومرّر منطقة المعاينة. تُظهر البطاقات موضع المحتوى، وتعرض القيم المواضع الفعلية للمحتوى والمؤشر."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Switch combinations and scroll the preview. The cards show content placement, while the values report the resolved content and indicator insets."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切换不同组合并滚动预览区域。卡片用于观察内容位置，下方数值显示内容与指示器最终生效的 inset。"
          }
        }
      }
    },
