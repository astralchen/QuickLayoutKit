    "boundary.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بعض المحتوى يقرأه النظام ولا يتغير فوراً داخل التطبيق."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some content is system-owned and does not live-refresh inside the app."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "部分内容由系统读取，不会随应用内语言即时刷新。"
          }
        }
      }
    },
