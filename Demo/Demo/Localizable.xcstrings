    "safeAreaPadding.intro" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بدّل بين التركيبات ودوّر الجهاز لمراقبة حدود المنطقة الآمنة. يوضح الخط الأخضر المتقطع المنطقة الآمنة الحالية، وتعرض القيم الإطار الفعلي للصفحة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Switch combinations and rotate the device to inspect the safe-area boundary. The dashed green line marks the current safe area, while the values report the page frame."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切换不同组合并旋转设备，观察安全区域边界。绿色虚线表示当前安全区域，下方数值显示页面最终 frame。"
          }
        }
      }
    },
