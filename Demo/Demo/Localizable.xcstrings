    "positionAndZIndex.intro" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توضح هذه الصفحة موضع العناصر داخل المساحة المقترحة وكيفية ترتيب العناصر المتداخلة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This page shows how elements are placed inside the proposed space and how overlapping elements are ordered."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这个页面演示元素在建议空间内的定位方式，以及重叠元素的显示顺序。"
          }
        }
      }
    },
    "positionAndZIndex.position.description" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يضع position مركز العنصر عند إحداثي فعلي. لذلك تبقى النقاط نفسها في تخطيطي LTR وRTL."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "position places an element's center at a physical coordinate, so the points stay unchanged in LTR and RTL layouts."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "position 将元素中心放到物理坐标点，因此切换 LTR 与 RTL 时这些坐标保持不变。"
          }
        }
      }
    },
    "positionAndZIndex.zIndex.description" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظهر القيمة الأكبر في المقدمة. تم تعريف B قبل C، لكن zIndex(3) يضع B فوق C."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Higher values appear in front. B is declared before C, but zIndex(3) still places B above C."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "数值越大，显示层级越靠前。B 虽然在 C 之前声明，但 zIndex(3) 仍使 B 位于 C 上方。"
          }
        }
      }
    },
